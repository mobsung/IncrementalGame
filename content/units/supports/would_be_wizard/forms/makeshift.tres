[gd_resource type="Resource" format=3]
[ext_resource type="Texture2D" path="res://content/units/supports/would_be_wizard/visuals/icons/weighted_staff.tres" id="icon_weighted_staff"]
[ext_resource type="Texture2D" path="res://content/units/supports/would_be_wizard/visuals/icons/sleight_of_hand.tres" id="icon_sleight_of_hand"]
