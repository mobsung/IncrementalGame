[ext_resource type="Script" path="res://scripts/data/evolution_definition.gd" id="evolution_type"]
[ext_resource type="Resource" path="res://content/units/supports/would_be_wizard/forms/archmage.tres" id="archmage"]

[sub_resource type="Resource" id="evolve_archmage"]
script = ExtResource("evolution_type")
id = &"archmage"
required_level = 30
form = ExtResource("archmage")
description = "Permanent branch. Refunds level points; preserves level, XP and Gold purchases."


[resource]
script = ExtResource("script")
id = &"wizard_makeshift"
display_name = "Makeshift Wizard"
unit_class = "ranged"
wizard_role = "makeshift"
basic_name = "Weighted Staff"
max_health = 250.0
physical_attack = 18.0
magic_attack = 16.0
ability_power = 24.0
armor = 6.0
magic_resistance = 8.0
attack_speed = 1.0
movement_speed = 220.0
engagement_radius = 350.0
attack_range = 120.0
gold = 0.0
experience = 0.0
souls = 0.0
critical_chance = 0.05
basic_damage = ExtResource("basic")
visual = ExtResource("visual")
basic_projectile_speed = 0.0
active_abilities = Array[ExtResource("ability_type")]([ExtResource("prototype_trick")])
passive_names = PackedStringArray("Sleight of Hand")
evolution_options = Array[ExtResource("evolution_type")]([SubResource("evolve_archmage")])
basic_icon = ExtResource("icon_weighted_staff")
passive_icons = Array[Texture2D]([ExtResource("icon_sleight_of_hand")])
