[gd_resource type="Resource" format=3]
[ext_resource type="Texture2D" path="res://content/units/supports/would_be_wizard/visuals/icons/training_staff.tres" id="icon_training_staff"]
[ext_resource type="Texture2D" path="res://content/units/supports/would_be_wizard/visuals/icons/hard_lessons.tres" id="icon_hard_lessons"]
[ext_resource type="Script" path="res://scripts/data/combatant_definition.gd" id="script"]
[ext_resource type="Resource" path="res://content/units/supports/would_be_wizard/visuals/apprentice.tres" id="visual"]
[ext_resource type="Resource" path="res://content/units/supports/would_be_wizard/abilities/physical_basic.tres" id="basic"]
[ext_resource type="Resource" path="res://content/units/supports/would_be_wizard/abilities/headlong_swing.tres" id="headlong_swing"]
[ext_resource type="Script" path="res://scripts/data/ability_definition.gd" id="ability_type"]
[ext_resource type="Script" path="res://scripts/data/evolution_definition.gd" id="evolution_type"]
[ext_resource type="Resource" path="res://content/units/supports/would_be_wizard/forms/acolyte.tres" id="acolyte"]
[ext_resource type="Resource" path="res://content/units/supports/would_be_wizard/forms/makeshift.tres" id="makeshift"]

[sub_resource type="Resource" id="evolve_acolyte"]
script = ExtResource("evolution_type")
id = &"acolyte"
required_level = 10
form = ExtResource("acolyte")
description = "Permanent branch. Refunds level points; preserves level, XP and Gold purchases."

[sub_resource type="Resource" id="evolve_makeshift"]
script = ExtResource("evolution_type")
id = &"makeshift"
required_level = 10
form = ExtResource("makeshift")
description = "Permanent branch. Refunds level points; preserves level, XP and Gold purchases."


[resource]
script = ExtResource("script")
id = &"would_be_wizard"
display_name = "Reckless Apprentice"
unit_class = "warrior"
wizard_role = "apprentice"
basic_name = "Training Staff"
max_health = 250.0
physical_attack = 18.0
magic_attack = 16.0
ability_power = 24.0
armor = 6.0
magic_resistance = 8.0
attack_speed = 1.0
movement_speed = 220.0
engagement_radius = 350.0
attack_range = 105.0
gold = 0.0
experience = 0.0
souls = 0.0
critical_chance = 0.05
basic_damage = ExtResource("basic")
visual = ExtResource("visual")
basic_projectile_speed = 0.0
active_abilities = Array[ExtResource("ability_type")]([ExtResource("headlong_swing")])
passive_names = PackedStringArray("Hard Lessons")
evolution_options = Array[ExtResource("evolution_type")]([SubResource("evolve_acolyte"),SubResource("evolve_makeshift")])
basic_icon = ExtResource("icon_training_staff")
passive_icons = Array[Texture2D]([ExtResource("icon_hard_lessons")])
