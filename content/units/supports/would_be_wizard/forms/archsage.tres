[resource]
script = ExtResource("script")
id = &"wizard_archsage"
display_name = "Grimoire Archsage"
unit_class = "healer"
wizard_role = "archsage"
basic_name = "Living Script"
max_health = 250.0
physical_attack = 18.0
magic_attack = 16.0
ability_power = 24.0
armor = 6.0
magic_resistance = 8.0
attack_speed = 1.0
movement_speed = 220.0
engagement_radius = 350.0
attack_range = 270.0
gold = 0.0
experience = 0.0
souls = 0.0
critical_chance = 0.05
basic_damage = ExtResource("basic")
visual = ExtResource("visual")
basic_projectile_speed = 700.0
active_abilities = Array[ExtResource("ability_type")]([ExtResource("rewrite_wounds"),ExtResource("shared_margins"),ExtResource("final_revision")])
passive_names = PackedStringArray("Living Grimoire","The Story Continues")
basic_icon = ExtResource("icon_living_script")
passive_icons = Array[Texture2D]([ExtResource("icon_living_grimoire"),ExtResource("icon_the_story_continues")])
