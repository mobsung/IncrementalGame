[gd_scene load_steps=2 format=3]
[ext_resource type="Script" path="res://scripts/presentation/upgrade_panel.gd" id="1"]

[node name="UpgradePanel" type="VBoxContainer"]
theme_override_constants/separation = 8
script = ExtResource("1")

[node name="GoldHeading" type="Label" parent="."]
layout_mode = 2
text = "Individual Gold upgrades"

[node name="GoldOffers" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2

[node name="Points" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
text = "Level upgrades"

[node name="LevelOffers" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2

[node name="Hint" type="Label" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 13
autowrap_mode = 2
text = "Hover an upgrade for its effect. Purchases persist through Chrono break. Level points cannot be refunded."
